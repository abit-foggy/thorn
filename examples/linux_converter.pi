# linux_converter.pi - Convert Linux Kbuild/GNU Make trees to Ninja or POSIX Make
# Demonstrates standalone Pith scripting with native C FFI hooks.

import "../src/decompile.c"

print "=========================================================="
print "Linux Kbuild -> Ninja / POSIX Make Converter (Pith script)"
print "=========================================================="

# 1. Reset state and configure project metadata
decompile.reset()
decompile.set_project("linux_kernel")
decompile.set_compiler("gcc")
decompile.set_ar("ar")

# 2. Hook: Filter out unit tests and host-only validation targets
decompile.ignore_target("test_*")
decompile.ignore_target("kunit_*")
decompile.ignore_target("selftest_*")

# 3. Hook: Remap legacy or vendor module names
decompile.remap_target("legacy_net_drv", "net_core")

# 4. Hook: Strip compiler flags not supported by standard toolchains
decompile.strip_cflag("-fconserve-stack")
decompile.strip_cflag("-mrecord-mcount")
decompile.strip_cflag("-fno-var-tracking-assignments")

# 5. Hook: Inject portable kernel definitions and architecture headers
decompile.inject_cflag("*", "-D__KERNEL__")
decompile.inject_cflag("*", "-O2")
decompile.inject_include("*", "include")
decompile.inject_include("*", "include/uapi")
decompile.inject_include("*", "arch/x86/include")

# 6. Sample Kbuild Makefile text with multi-line continuations,
# composite module definitions (-objs), and += appending.
kbuild_source = "ccflags-y := -Wall -Wstrict-prototypes\n\n# Core subsystem objects with backslash continuation\nobj-y := init.o \\\n         main.o \\\n         version.o\nobj-y += sys.o\n\n# Composite network driver module\nobj-m += legacy_net_drv.o\nlegacy_net_drv-objs := net_main.o \\\n                       net_hw.o \\\n                       net_ring.o\n\n# Unit tests (should be ignored by hooks)\nobj-y += kunit_test.o\nkunit_test-objs := test_core.o test_cases.o\n"

print "Ingesting Linux Kbuild Makefile specification..."
ok = decompile.parse_string(kbuild_source)
if ok == 1
    print "Ingestion succeeded."
else
    print "Ingestion failed!"
end

# 7. Inspect resolved targets
ntgts = decompile.target_count()
print "Discovered targets count:"
print ntgts

mut i = 0
while i < ntgts
    name = decompile.get_target_name(i)
    srcs = decompile.get_target_sources(i)
    cfl = decompile.get_target_cflags(i)
    inc = decompile.get_target_includes(i)
    print "--- Target "
    print name
    print "  sources:  " + srcs
    print "  flags:    " + cfl
    print "  includes: " + inc
    i = i + 1
end

# 8. Export to Ninja and POSIX Make
print "Emitting Ninja build graph..."
ninja_preview = decompile.to_ninja()
print ninja_preview

print "Emitting POSIX Makefile..."
posix_preview = decompile.to_posix_make()
print posix_preview

print "Linux tree conversion complete."
