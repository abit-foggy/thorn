# build.thorn - thorn's own build specification.
#
# Read at runtime by out/thorn (embed mode: no per-project binaries).
# Generate the backends into out/artifacts and build from the root:
#
#     ./out/thorn --out-dir out/artifacts
#     samu -f out/artifacts/build.ninja
#
# Two targets:
#   thorn_core - thorn's own sources under their c_thorn_engine_*
#                symbol renames (the same mangling pith applies to
#                imported C units), archived for the exe and usable
#                as the temp-executable fallback link object
#   thorn      - the executable: pith's frontend objects (the
#                embedded language) linked with thorn_core
#
# Source order in thorn_core matters to single-pass archive linking:
# main first, then the engine it references, then the decompiler.

thorn_engine.project("thorn")

thorn_engine.add_target("thorn_core", thorn_engine.static_lib)
thorn_engine.add_source("thorn_core", "src/thorn_main.c")
thorn_engine.add_source("thorn_core", "src/thorn_engine.c")
thorn_engine.add_source("thorn_core", "src/thorn_decompile.c")
thorn_engine.add_cflag("thorn_core", "-std=c99")
thorn_engine.add_cflag("thorn_core", "-O2")
thorn_engine.add_cflag("thorn_core", "-Wall")
thorn_engine.add_cflag("thorn_core", "-Wextra")
thorn_engine.add_cflag("thorn_core", "-Wno-unused-parameter")
thorn_engine.add_cflag("thorn_core", "-D_DEFAULT_SOURCE")
thorn_engine.add_cflag("thorn_core", "-Dproject=c_thorn_engine_project")
thorn_engine.add_cflag("thorn_core", "-Dexe=c_thorn_engine_exe")
thorn_engine.add_cflag("thorn_core", "-Dstatic_lib=c_thorn_engine_static_lib")
thorn_engine.add_cflag("thorn_core", "-Dshared_lib=c_thorn_engine_shared_lib")
thorn_engine.add_cflag("thorn_core", "-Dadd_target=c_thorn_engine_add_target")
thorn_engine.add_cflag("thorn_core", "-Dadd_source=c_thorn_engine_add_source")
thorn_engine.add_cflag("thorn_core", "-Dadd_cflag=c_thorn_engine_add_cflag")
thorn_engine.add_cflag("thorn_core", "-Dadd_ldflag=c_thorn_engine_add_ldflag")
thorn_engine.add_cflag("thorn_core", "-Dadd_include=c_thorn_engine_add_include")
thorn_engine.add_cflag("thorn_core", "-Dadd_order_dep=c_thorn_engine_add_order_dep")
thorn_engine.add_cflag("thorn_core", "-Dpkg_config=c_thorn_engine_pkg_config")
thorn_engine.add_cflag("thorn_core", "-Demit=c_thorn_engine_emit")
thorn_engine.add_include("thorn_core", "../pith/include")

thorn_engine.add_target("thorn", thorn_engine.exe)
thorn_engine.add_source("thorn", "../pith/src/lexer.c")
thorn_engine.add_source("thorn", "../pith/src/parser.c")
thorn_engine.add_source("thorn", "../pith/src/gen_qbe.c")
thorn_engine.add_source("thorn", "../pith/src/engine_proxy.c")
thorn_engine.add_source("thorn", "../pith/src/pith_embed.c")
thorn_engine.add_source("thorn", "../pith/src/tar.c")
thorn_engine.add_source("thorn", "../pith/src/config.c")
thorn_engine.add_source("thorn", "../pith/src/cffi.c")
thorn_engine.add_cflag("thorn", "-std=c99")
thorn_engine.add_cflag("thorn", "-O2")
thorn_engine.add_cflag("thorn", "-Wall")
thorn_engine.add_cflag("thorn", "-Wextra")
thorn_engine.add_cflag("thorn", "-Wno-unused-parameter")
thorn_engine.add_cflag("thorn", "-D_POSIX_C_SOURCE=200809L")
thorn_engine.add_cflag("thorn", "-D_DEFAULT_SOURCE")
thorn_engine.add_cflag("thorn", "-DPITH_HAVE_LIBTCC=1")
thorn_engine.add_cflag("thorn", "-DPITH_HAVE_LIBQBE=1")
thorn_engine.add_include("thorn", "../pith/include")
thorn_engine.add_include("thorn", "../pith/vendor/tcc")
thorn_engine.add_include("thorn", "../pith/vendor/qbe")
thorn_engine.add_ldflag("thorn", "out/artifacts/thorn_core.a")
thorn_engine.add_ldflag("thorn", "../pith/vendor/qbe/libqbe.a")
thorn_engine.add_ldflag("thorn", "../pith/vendor/tcc/libtcc.a")
thorn_engine.add_ldflag("thorn", "-ldl")
thorn_engine.add_ldflag("thorn", "../pith/runtime/libruntime.a")
thorn_engine.add_order_dep("thorn", "out/artifacts/thorn_core.a")
