# build.thorn - thorn's own build specification.
#
# Read at runtime by out/thorn (embed mode: no per-project binaries).
# Generate the backends into out/artifacts and build from the root:
#
#     ./out/thorn --out-dir out/artifacts
#     samu -f out/artifacts/build.ninja
#
# Two targets:
#   thorn_core - thorn's own sources under their c_engine_*
#                symbol renames (the same mangling pith applies to
#                imported C units), archived for the exe and usable
#                as the temp-executable fallback link object
#   thorn      - the executable: pith's frontend objects (the
#                embedded language) linked with thorn_core
#
# Source order in thorn_core matters to single-pass archive linking:
# main first, then the engine it references, then the decompiler.

engine.project("thorn")
engine.backend("ninja")

engine.add_target("thorn_core", engine.static_lib)
engine.add_source("thorn_core", "src/main.c")
engine.add_source("thorn_core", "src/engine.c")
engine.add_source("thorn_core", "src/decompile.c")
engine.add_cflag("thorn_core", "-std=c99")
engine.add_cflag("thorn_core", "-O2")
engine.add_cflag("thorn_core", "-Wall")
engine.add_cflag("thorn_core", "-Wextra")
engine.add_cflag("thorn_core", "-Wno-unused-parameter")
engine.add_cflag("thorn_core", "-D_DEFAULT_SOURCE")
engine.add_cflag("thorn_core", "-Dproject=c_engine_project")
engine.add_cflag("thorn_core", "-Dbackend=c_engine_backend")
engine.add_cflag("thorn_core", "-Dexe=c_engine_exe")
engine.add_cflag("thorn_core", "-Dstatic_lib=c_engine_static_lib")
engine.add_cflag("thorn_core", "-Dshared_lib=c_engine_shared_lib")
engine.add_cflag("thorn_core", "-Dadd_target=c_engine_add_target")
engine.add_cflag("thorn_core", "-Dadd_source=c_engine_add_source")
engine.add_cflag("thorn_core", "-Dadd_cflag=c_engine_add_cflag")
engine.add_cflag("thorn_core", "-Dadd_ldflag=c_engine_add_ldflag")
engine.add_cflag("thorn_core", "-Dadd_include=c_engine_add_include")
engine.add_cflag("thorn_core", "-Dadd_order_dep=c_engine_add_order_dep")
engine.add_cflag("thorn_core", "-Dadd_command=c_engine_add_command")
engine.add_cflag("thorn_core", "-Dpkg_config=c_engine_pkg_config")
engine.add_cflag("thorn_core", "-Demit=c_engine_emit")
engine.add_include("thorn_core", "../pith/include")

engine.add_target("thorn", engine.exe)
engine.add_source("thorn", "../pith/src/lexer.c")
engine.add_source("thorn", "../pith/src/parser.c")
engine.add_source("thorn", "../pith/src/gen_qbe.c")
engine.add_source("thorn", "../pith/src/engine_proxy.c")
engine.add_source("thorn", "../pith/src/pith_embed.c")
engine.add_source("thorn", "../pith/src/tar.c")
engine.add_source("thorn", "../pith/src/config.c")
engine.add_source("thorn", "../pith/src/cffi.c")
engine.add_cflag("thorn", "-std=c99")
engine.add_cflag("thorn", "-O2")
engine.add_cflag("thorn", "-Wall")
engine.add_cflag("thorn", "-Wextra")
engine.add_cflag("thorn", "-Wno-unused-parameter")
engine.add_cflag("thorn", "-D_POSIX_C_SOURCE=200809L")
engine.add_cflag("thorn", "-D_DEFAULT_SOURCE")
engine.add_cflag("thorn", "-DPITH_HAVE_LIBTCC=1")
engine.add_cflag("thorn", "-DPITH_HAVE_LIBQBE=1")
engine.add_include("thorn", "../pith/include")
engine.add_include("thorn", "../pith/vendor/tcc")
engine.add_include("thorn", "../pith/vendor/qbe")
engine.add_ldflag("thorn", "out/artifacts/thorn_core.a")
engine.add_ldflag("thorn", "../pith/vendor/qbe/libqbe.a")
engine.add_ldflag("thorn", "../pith/vendor/tcc/libtcc.a")
engine.add_ldflag("thorn", "-ldl")
engine.add_ldflag("thorn", "../pith/runtime/libruntime.a")
engine.add_order_dep("thorn", "out/artifacts/thorn_core.a")
